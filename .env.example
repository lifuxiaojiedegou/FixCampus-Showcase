# 复制为 .env 后将所有 REPLACE_WITH_* 替换为自定义本机密码（8～64 字符）
# .env 已被 .gitignore 忽略，切勿提交到仓库

MYSQL_ROOT_PASSWORD=REPLACE_WITH_MYSQL_ROOT_PASSWORD
FIXCAMPUS_DB_PASSWORD=REPLACE_WITH_APP_DB_PASSWORD
FIXCAMPUS_MIGRATION_PASSWORD=REPLACE_WITH_MIGRATION_DB_PASSWORD

# 预置三角色演示账号（student01 / admin01 / worker01）密码：长度 8～64 字符，且三个账号密码必须互不相同
FIXCAMPUS_DEMO_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_DEMO_PASSWORD
FIXCAMPUS_DEMO_WORKER_PASSWORD=REPLACE_WITH_WORKER_DEMO_PASSWORD
FIXCAMPUS_DEMO_STUDENT_PASSWORD=REPLACE_WITH_STUDENT_DEMO_PASSWORD
