FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /workspace

COPY pom.xml ./
COPY src src
RUN --mount=type=cache,target=/root/.m2 mvn --batch-mode -DskipTests package

FROM eclipse-temurin:25-jre
WORKDIR /app

RUN useradd --create-home --uid 10001 app \
    && mkdir -p /data \
    && chown -R app:app /app /data \
    && chmod 700 /data

COPY --from=build --chown=app:app /workspace/target/fixcampus-0.0.1-SNAPSHOT.jar /app/app.jar

USER app
EXPOSE 18080

HEALTHCHECK --interval=5s --timeout=3s --start-period=15s --retries=20 \
  CMD bash -c 'exec 3<>/dev/tcp/127.0.0.1/18080'

ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
