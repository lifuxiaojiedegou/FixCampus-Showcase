{
  "name": "fixcampus-ui-only",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev:web": "vite --mode web-slice --host 127.0.0.1 --port 5173 --strictPort",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5173 --strictPort",
    "dev:mock": "vite --mode mock --host 127.0.0.1 --port 5173 --strictPort",
    "dev": "vite --mode web-slice --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:web": "vite preview --mode web-slice --host 127.0.0.1 --port 5173 --strictPort",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:demo": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build --mode demo",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:no-network": "node scripts/check-no-network.mjs",
    "licenses": "node scripts/license-inventory.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run check:no-network && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "@tanstack/react-query": "5.107.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7",
    "@hookform/resolvers": "7.0.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "@vitejs/plugin-react": "6.2.1",
    "vitest": "5.1.0",
    "jsdom": "31.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "eslint": "10.14.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2"
  }
}
